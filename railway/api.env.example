# Railway service: api
# Source: backend/src/ot_backend/core/config.py
# Copy to railway/api.env, fill in, then push with:
#   railway link
#   railway variables --service api --environment production \
#     $(while IFS= read -r l; do [[ -z "$l" || "$l" =~ ^# ]] || printf -- '--set %q ' "$l"; done < railway/api.env)

# --- Required: DB binding ---
# Railway template-injected from the Postgres service. Leave the literal placeholder;
# Railway resolves ${{...}} at deploy time. No secret to fill.
DATABASE_URL=${{Postgres.DATABASE_URL}}

# --- Required: runtime mode ---
OT_ENV=production
OT_SERVICE_ROLE=api

# Match the port the frontend nginx proxy targets (API_PROXY_TARGET=...:8000).
# Without this Railway auto-injects PORT=8080 and the proxy 502s.
PORT=8000

# --- Required: public URLs / CORS ---
OT_PUBLIC_URL=https://oracletutor.org
OT_CORS_ORIGINS=https://oracletutor.org,https://admin.oracletutor.org
# Hosts the api will accept on the Host header. Required when the api is
# behind a frontend proxy that forwards the original Host (oracletutor.org)
# — without this the api 400s with "Invalid host header".
OT_ALLOWED_HOSTS=oracletutor.org,admin.oracletutor.org

# --- Required: admin auth ---
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=

# --- Required: Cloudflare Access (admin host gate) ---
# Fail-closed in production — admin routes refuse traffic if either is unset.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# --- Required: artifact storage (Cloudflare R2 in prod) ---
SEMANTIC_ARTIFACT_ENDPOINT=
SEMANTIC_ARTIFACT_ACCESS_KEY_ID=
SEMANTIC_ARTIFACT_SECRET_ACCESS_KEY=
SEMANTIC_ARTIFACT_BUCKET=oracletutor-semantic-artifacts
SEMANTIC_ARTIFACT_REGION=auto

# --- Optional: tuning (defaults shown; uncomment to override) ---
# ADMIN_LOGIN_MAX_FAILURES=5
# ADMIN_LOGIN_LOCKOUT_SECONDS=900
# SEMANTIC_ACTIVE_MODEL_POLL_SECONDS=5
# SEMANTIC_ONNX_INTRA_OP_THREADS=1
# SEMANTIC_ONNX_INTER_OP_THREADS=1
# OT_ORACLE_POOL_REFRESH_SECONDS=600
# OT_MAX_REQUEST_BYTES=32768
# OT_MAX_QUERY_LENGTH=200
# OT_SCHEMA_WAIT_TIMEOUT_SECONDS=30
