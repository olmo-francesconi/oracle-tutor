# Railway service: ingest-worker
# One-shot container, scheduled via Railway Cron (default 0 2 * * *), restart policy "Never".
# Source: backend/src/ot_backend/ingest/{main,fetch_tags,scryfall_ingestion}.py

# --- Required: DB binding ---
DATABASE_URL=${{Postgres.DATABASE_URL}}

# --- Required: runtime mode ---
OT_ENV=production
# OT_SERVICE_ROLE=worker shrinks the SQLAlchemy pool from 10 to 2 — important for
# one-shot containers so they don't open more connections than they use.
OT_SERVICE_ROLE=worker

# --- Optional: trigger metadata (logged into ingestion_logs.trigger_type) ---
# OT_TRIGGER_TYPE=cron

# --- Optional: Scryfall Tagger sync tuning ---
# TAG_FETCH_CONCURRENCY=4
# TAG_FETCH_RATE_LIMIT_SLEEP=0.4

# --- Do NOT set in production ---
# OT_ALLOW_SCHEMA_RESET — only used locally to wipe the dev DB; ignore in Railway.
# ADMIN_*, CF_ACCESS_*, SEMANTIC_ARTIFACT_* — ingest worker never reads any of these.
# MODAL_*, SEMANTIC_LLM_* — local-only operator scripts; do not set on Railway.
