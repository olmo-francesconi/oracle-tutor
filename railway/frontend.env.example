# Railway service: frontend
# Source: frontend/Dockerfile (multi-stage Vite build + nginx runtime), frontend/nginx/

# --- Build-time (baked into the Vite bundle) ---
# Railway honors these during `npm run build` in the builder stage.
VITE_API_URL=/api
VITE_APP_URL=https://oracletutor.org

# --- Runtime (read by nginx config at container start) ---
# Railway auto-assigns PORT; the nginx config binds to it.
PORT=8080

# API service-to-service URL. ${{api.RAILWAY_PRIVATE_DOMAIN}} resolves to the
# api container's internal hostname inside the Railway project network.
API_PROXY_TARGET=http://${{api.RAILWAY_PRIVATE_DOMAIN}}:8000

# nginx resolver for runtime DNS lookups of the upstream. Leave this UNSET —
# the Dockerfile defaults it to [fd12::10] (Railway's IPv6 internal resolver),
# and the nginx config has `ipv6=on` on every resolver directive. This is the
# pattern that worked through v1.x. Only override if you know what you're
# doing.

# Host-based admin gate. nginx rejects /admin/* unless Host == this value.
ADMIN_HOST=admin.oracletutor.org
