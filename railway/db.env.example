# Railway service: db (pgvector/pgvector:pg17)
#
# Nothing to fill manually. Railway's Postgres template auto-generates:
#   POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD, DATABASE_URL, PGDATA
# Other services reference DATABASE_URL via ${{Postgres.DATABASE_URL}}.
#
# After the service is up, run once via the Railway shell or psql:
#   CREATE EXTENSION IF NOT EXISTS vector;
#
# If you ever expose the DB publicly (Railway → Postgres → Settings → public TCP
# proxy), rotate POSTGRES_PASSWORD to something long first.
