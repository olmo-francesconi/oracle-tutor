# syntax=docker/dockerfile:1

FROM ghcr.io/astral-sh/uv:python3.12-bookworm AS builder

WORKDIR /app

COPY pyproject.toml uv.lock* ./

RUN uv venv /opt/venv
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:${PATH}"
ENV UV_CACHE_DIR=/root/.cache/uv

RUN if [ -f uv.lock ]; then \
      uv sync --active --frozen --no-install-project --extra semantic --extra worker; \
    else \
      uv sync --active --no-install-project --extra semantic --extra worker; \
    fi

COPY src/oracle_tutor_api/__init__.py ./src/oracle_tutor_api/
COPY src/oracle_tutor_api/core ./src/oracle_tutor_api/core
COPY src/oracle_tutor_api/worker ./src/oracle_tutor_api/worker
COPY src/oracle_tutor_api/api ./src/oracle_tutor_api/api
COPY src/oracle_tutor_api/semantic ./src/oracle_tutor_api/semantic

FROM python:3.12-slim AS runtime

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:${PATH}" \
    PYTHONPATH=/app/src

RUN set -eux; \
    groupadd -r app && useradd -r -g app -d /app -s /usr/sbin/nologin app; \
    mkdir -p /app/data/semantic; \
    chown -R app:app /app/data

COPY --from=builder --chown=app:app /opt/venv /opt/venv
COPY --chown=app:app src/oracle_tutor_api/__init__.py ./src/oracle_tutor_api/
COPY --chown=app:app src/oracle_tutor_api/core ./src/oracle_tutor_api/core
COPY --chown=app:app src/oracle_tutor_api/worker ./src/oracle_tutor_api/worker
COPY --chown=app:app src/oracle_tutor_api/api ./src/oracle_tutor_api/api
COPY --chown=app:app src/oracle_tutor_api/semantic ./src/oracle_tutor_api/semantic

USER app

CMD ["sh", "-c", "python -m oracle_tutor_api.semantic.train && python -m oracle_tutor_api.semantic.compute"]
