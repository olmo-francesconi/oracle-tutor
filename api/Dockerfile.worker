# syntax=docker/dockerfile:1

FROM ghcr.io/astral-sh/uv:python3.12-bookworm AS builder

WORKDIR /app

COPY pyproject.toml uv.lock* ./

RUN uv venv /opt/venv
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:${PATH}"
ENV UV_CACHE_DIR=/root/.cache/uv

RUN if [ -f uv.lock ]; then \
      uv sync --active --frozen --no-install-project --extra worker; \
    else \
      uv sync --active --no-install-project --extra worker; \
    fi

COPY src/oracle_tutor_api/__init__.py ./src/oracle_tutor_api/
COPY src/oracle_tutor_api/core ./src/oracle_tutor_api/core
COPY src/oracle_tutor_api/worker ./src/oracle_tutor_api/worker

FROM python:3.12-slim AS runtime

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:${PATH}" \
    PYTHONPATH=/app/src

RUN set -eux; \
    groupadd -r app && useradd -r -g app -d /app -s /usr/sbin/nologin app; \
    mkdir -p /app/data; \
    chown -R app:app /app/data

COPY --from=builder --chown=app:app /opt/venv /opt/venv
COPY --chown=app:app src/oracle_tutor_api/__init__.py ./src/oracle_tutor_api/
COPY --chown=app:app src/oracle_tutor_api/core ./src/oracle_tutor_api/core
COPY --chown=app:app src/oracle_tutor_api/worker ./src/oracle_tutor_api/worker

USER app

# One-shot cron-friendly entrypoint (runs once and exits).
CMD ["python", "-m", "oracle_tutor_api.worker.main", "--strict", "--trigger-type", "cron"]


