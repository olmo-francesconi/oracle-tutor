# syntax=docker/dockerfile:1

# ── builder-base ──────────────────────────────────────────────────────
FROM ghcr.io/astral-sh/uv:python3.12-bookworm AS builder-base

WORKDIR /app

COPY pyproject.toml uv.lock* ./

RUN uv venv /opt/venv
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:${PATH}"
ENV UV_CACHE_DIR=/root/.cache/uv

# ── builder-ingest ────────────────────────────────────────────────────
FROM builder-base AS builder-ingest

RUN if [ -f uv.lock ]; then \
      uv sync --active --frozen --no-install-project --extra scryfall-sync; \
    else \
      uv sync --active --no-install-project --extra scryfall-sync; \
    fi

COPY src/ot_backend/__init__.py ./src/ot_backend/
COPY src/ot_backend/core ./src/ot_backend/core
COPY src/ot_backend/ingest ./src/ot_backend/ingest
COPY src/ot_backend/api ./src/ot_backend/api
COPY src/ot_backend/semantic ./src/ot_backend/semantic
COPY alembic ./alembic

# ── builder-semantic ──────────────────────────────────────────────────
FROM builder-base AS builder-semantic

RUN if [ -f uv.lock ]; then \
      uv sync --active --frozen --no-install-project --extra api --extra semantic-train; \
    else \
      uv sync --active --no-install-project --extra api --extra semantic-train; \
    fi

RUN uv pip install "modal>=0.73"

COPY src/ot_backend/__init__.py ./src/ot_backend/
COPY src/ot_backend/core ./src/ot_backend/core
COPY src/ot_backend/semantic ./src/ot_backend/semantic
COPY alembic ./alembic

# ── runtime-base ──────────────────────────────────────────────────────
FROM python:3.12-slim AS runtime-base

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:${PATH}" \
    PYTHONPATH=/app/src

RUN set -eux; \
    groupadd -r app && useradd -r -g app -d /app -s /usr/sbin/nologin app; \
    mkdir -p /app/data; \
    chown -R app:app /app/data

# ── ingest target ─────────────────────────────────────────────────────
FROM runtime-base AS ingest

COPY --from=builder-ingest --chown=app:app /opt/venv /opt/venv
COPY --chown=app:app src/ot_backend/__init__.py ./src/ot_backend/
COPY --chown=app:app src/ot_backend/core ./src/ot_backend/core
COPY --chown=app:app src/ot_backend/ingest ./src/ot_backend/ingest
COPY --chown=app:app src/ot_backend/api ./src/ot_backend/api
COPY --chown=app:app src/ot_backend/semantic ./src/ot_backend/semantic
COPY --from=builder-ingest --chown=app:app /app/alembic ./alembic

USER app

CMD ["python", "-m", "ot_backend.ingest.main", "--strict", "--trigger-type", "cron"]

# ── semantic-base (shared by dataset / train / promote) ───────────────
FROM runtime-base AS semantic-base

ENV HF_HOME=/app/data/huggingface \
    TRANSFORMERS_CACHE=/app/data/huggingface/transformers \
    SENTENCE_TRANSFORMERS_HOME=/app/data/huggingface/sentence-transformers

RUN mkdir -p /app/data/huggingface/transformers /app/data/huggingface/sentence-transformers && \
    chown -R app:app /app/data

COPY --from=builder-semantic --chown=app:app /opt/venv /opt/venv
COPY --chown=app:app src/ot_backend/__init__.py ./src/ot_backend/
COPY --chown=app:app src/ot_backend/core ./src/ot_backend/core
COPY --chown=app:app src/ot_backend/semantic ./src/ot_backend/semantic
COPY --from=builder-semantic --chown=app:app /app/alembic ./alembic

USER app

# ── dataset target ────────────────────────────────────────────────────
FROM semantic-base AS dataset

CMD ["python", "-m", "ot_backend.semantic.dataset_worker"]

# ── train target ──────────────────────────────────────────────────────
FROM semantic-base AS train

CMD ["python", "-m", "ot_backend.semantic.train_worker"]

# ── promote target ────────────────────────────────────────────────────
FROM semantic-base AS promote

CMD ["python", "-m", "ot_backend.semantic.promote_worker"]
