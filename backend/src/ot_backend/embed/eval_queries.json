{
  "description": "Hand-curated queries for evaluating semantic search quality before/after training runs.",
  "queries": [
    {
      "query": "draw a card",
      "expected_cards": ["Ancestral Recall", "Brainstorm", "Opt", "Ponder", "Preordain"],
      "notes": "Baseline short keyword query — should be an easy win"
    },
    {
      "query": "card draw",
      "expected_cards": ["Ancestral Recall", "Brainstorm", "Opt", "Divination"],
      "notes": "Same intent, noun-phrase form"
    },
    {
      "query": "destroy target creature",
      "expected_cards": ["Terror", "Murder", "Doom Blade", "Go for the Throat"],
      "notes": "Exact oracle text fragment — literal match should dominate"
    },
    {
      "query": "creature removal",
      "expected_cards": ["Murder", "Terror", "Doom Blade", "Swords to Plowshares", "Path to Exile"],
      "notes": "Concept query — no card says 'creature removal' in oracle text"
    },
    {
      "query": "tap for green mana",
      "expected_cards": ["Llanowar Elves", "Elvish Mystic", "Fyndhorn Elves", "Birds of Paradise"],
      "notes": "Matches normalized activation text"
    },
    {
      "query": "mana ramp",
      "expected_cards": ["Rampant Growth", "Cultivate", "Kodama's Reach", "Harrow", "Llanowar Elves"],
      "notes": "Concept with no oracle text match — pure semantic"
    },
    {
      "query": "punish opponents for drawing cards",
      "expected_cards": ["Underworld Dreams", "Nekusar, the Mindrazer", "Runeflare Trap", "Fate Unraveler"],
      "notes": "Multi-word concept query — the key SBERT test case"
    },
    {
      "query": "make tokens",
      "expected_cards": ["Goblin Rabblemaster", "Raise the Alarm", "Lingering Souls", "Secure the Wastes"],
      "notes": "Short concept query"
    },
    {
      "query": "counterspell",
      "expected_cards": ["Counterspell", "Force of Will", "Mana Leak", "Negate", "Dissolve"],
      "notes": "Single-word query matching a card name and a mechanic"
    },
    {
      "query": "counter a spell",
      "expected_cards": ["Counterspell", "Force of Will", "Mana Drain", "Spell Pierce"],
      "notes": "Phrase variant — no card says exactly this"
    },
    {
      "query": "gain life",
      "expected_cards": ["Healing Salve", "Soul Warden", "Blessed Sanctuary", "Ajani's Pridemate"],
      "notes": "Short keyword query"
    },
    {
      "query": "drain life from opponent",
      "expected_cards": ["Drain Life", "Exsanguinate", "Consume Spirit", "Gray Merchant of Asphodel"],
      "notes": "Concept combining life loss and gain"
    },
    {
      "query": "reanimate a creature from graveyard",
      "expected_cards": ["Reanimate", "Animate Dead", "Unearth", "Phyrexian Delver"],
      "notes": "Long concept query — SBERT historically handles these better"
    },
    {
      "query": "search library for land",
      "expected_cards": ["Rampant Growth", "Cultivate", "Farseek", "Nature's Lore", "Sakura-Tribe Elder"],
      "notes": "Tutor variant"
    },
    {
      "query": "bounce creature back to hand",
      "expected_cards": ["Unsummon", "Vapor Snag", "Boomerang", "Into the Roil"],
      "notes": "Tempo removal concept"
    },
    {
      "query": "flying creature",
      "expected_cards": ["Serra Angel", "Sephara, Sky's Blade", "Mantis Rider"],
      "notes": "Keyword query — huge result set expected, checking precision"
    },
    {
      "query": "indestructible",
      "expected_cards": ["Darksteel Colossus", "Blightsteel Colossus", "Avacyn, Angel of Hope"],
      "notes": "Single keyword"
    },
    {
      "query": "proliferate counters",
      "expected_cards": ["Thrummingbird", "Contagion Engine", "Viral Drake", "Inexorable Tide"],
      "notes": "Keyword plus context"
    },
    {
      "query": "deal damage to all creatures",
      "expected_cards": ["Pyroclasm", "Anger of the Gods", "Sweltering Suns", "Earthquake"],
      "notes": "Board wipe variant — damage-based sweeper"
    },
    {
      "query": "cast spells for free",
      "expected_cards": ["Omniscience", "Fist of Suns", "Dream Halls"],
      "notes": "Abstract concept — no oracle text says 'for free'"
