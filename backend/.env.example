# backend/.env.example
# Copy to backend/.env and fill in. Loaded by docker compose (api, ingest-worker)
# via env_file, and by backend/scripts/* via _common.load_env().

# --- Database (must match POSTGRES_* in docker-compose.yml) ---
DB_USER=oracle
DB_PASSWORD=secret_password
DB_NAME=mtg_search
# DB_HOST/DB_PORT are forced to db:5432 by docker compose for containers.
# For host-side scripts hitting the dockerized db, use:
# DB_HOST=localhost
# DB_PORT=5432

# --- Admin auth ---
ADMIN_PASSWORD=admin123
ADMIN_JWT_SECRET=dev-admin-jwt-secret-change-me-please

# --- Artifact storage (Cloudflare R2 or MinIO) ---
# MinIO defaults (local docker-compose stack):
SEMANTIC_ARTIFACT_ENDPOINT=http://minio:9000
SEMANTIC_ARTIFACT_ACCESS_KEY_ID=minioadmin
SEMANTIC_ARTIFACT_SECRET_ACCESS_KEY=minioadmin123
SEMANTIC_ARTIFACT_BUCKET=semantic-artifacts
SEMANTIC_ARTIFACT_REGION=us-east-1

# Cloudflare R2 (uncomment and fill to point at production bucket):
# SEMANTIC_ARTIFACT_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# SEMANTIC_ARTIFACT_ACCESS_KEY_ID=<R2 API token access key>
# SEMANTIC_ARTIFACT_SECRET_ACCESS_KEY=<R2 API token secret>
# SEMANTIC_ARTIFACT_BUCKET=oracletutor-semantic-artifacts
# SEMANTIC_ARTIFACT_REGION=auto

# --- Modal ---
MODAL_TOKEN_ID=modal-token-id
MODAL_TOKEN_SECRET=modal-token-secret

# --- Optional ---
# OT_PUBLIC_URL=https://oracletutor.org
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=<application AUD tag>
