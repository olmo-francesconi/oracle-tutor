# Copy to .env (gitignored) and fill in. Used by local commands that touch the Railway bucket: training
# (train.*), promoting a model, publishing a snapshot, or running the app against the bucket:
#   uv run --env-file .env --project train python -m train.pipeline <model_id>
#   uv run --env-file .env python -m app.build --promote <model_id>
# Values: Railway → oracle-tutor bucket → Credentials, or `railway bucket credentials --bucket oracle-tutor --json`.
# Leave BUCKET empty for local mode (data/ and model/ instead of the bucket).

BUCKET=
ENDPOINT=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
REGION=

# Optional
# BUCKET_PATH_STYLE=1      # path-style addressing (older Railway buckets, MinIO)
# CACHE_DIR=               # downloaded models and snapshots (default: $TMPDIR/oracle-tutor)
# PUBLIC_URL=              # canonical origin for sitemap and link previews (web only)
# POLL_SECONDS=300         # web: how often to check current.json
# Frontend dev server (not read from this file; set in the shell): API_PROXY_TARGET=http://localhost:8000 npm run dev

# Modal (training GPU jobs) authenticates from ~/.modal.toml (`modal token new`), not from this file.
