server {
  listen ${PORT};

  server_tokens off;

  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size 32k;
  limit_req_status 429;

  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests" always;

  location ^~ /.well-known/ {
    try_files $uri =404;
  }

  location ~ /\.(?!well-known)(?:.*)$ {
    return 444;
  }

  location = /xmlrpc.php { return 444; }
  location = /wp-login.php { return 444; }
  location ^~ /wp-admin { return 444; }
  location ^~ /wp-content { return 444; }
  location ^~ /wp-includes { return 444; }
  location ^~ /wordpress { return 444; }
  location ^~ /wp { return 444; }
  location ^~ /phpmyadmin { return 444; }

  location / {
    set $block_bot 0;
    if ($is_bot) { set $block_bot "${block_bot}1"; }
    if ($bot_allowed_path = 0) { set $block_bot "${block_bot}1"; }
    if ($block_bot = 011) { return 403; }
    try_files $uri $uri/ /index.html;
  }

  location = /admin {
    return 301 /admin/;
  }

  location ^~ /admin/ {
    set $block_bot 0;
    if ($is_bot) { set $block_bot "${block_bot}1"; }
    if ($bot_allowed_path = 0) { set $block_bot "${block_bot}1"; }
    if ($block_bot = 011) { return 403; }
    try_files $uri $uri/ /admin/index.html;
  }

  location = /api/health {
    if ($is_bot) { return 403; }

    set $upstream_target ${API_PROXY_TARGET};
    rewrite ^/api/(.*)$ /$1 break;
    proxy_http_version 1.1;
    resolver [fd12::10] valid=10s ipv6=on;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
    access_log /dev/stdout main_ext;
    proxy_pass $upstream_target;
  }

  location = /api/admin/auth/token {
    if ($is_bot) { return 403; }

    limit_req zone=api_admin_login burst=5 nodelay;
    limit_conn api_conn 10;
    limit_except POST { deny all; }

    set $upstream_target ${API_PROXY_TARGET};
    rewrite ^/api/(.*)$ /$1 break;
    proxy_http_version 1.1;
    resolver [fd12::10] valid=10s ipv6=on;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
    access_log /dev/stdout main_ext;
    proxy_pass $upstream_target;
  }

  location = /api/version {
    if ($is_bot) { return 403; }

    set $upstream_target ${API_PROXY_TARGET};
    rewrite ^/api/(.*)$ /$1 break;
    proxy_http_version 1.1;
    resolver [fd12::10] valid=10s ipv6=on;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
    access_log /dev/stdout main_ext;
    proxy_pass $upstream_target;
  }

  location = /api/search {
    if ($is_bot) { return 403; }

    limit_req zone=api_global burst=30 nodelay;
    limit_req zone=api_search burst=20 nodelay;
    limit_conn api_conn 20;
    limit_except GET { deny all; }

    set $upstream_target ${API_PROXY_TARGET};
    rewrite ^/api/(.*)$ /$1 break;
    proxy_http_version 1.1;
    resolver [fd12::10] valid=10s ipv6=on;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
    access_log /dev/stdout main_ext;
    proxy_pass $upstream_target;
  }

  location = /api/similar-cards {
    if ($is_bot) { return 403; }

    limit_req zone=api_global burst=30 nodelay;
    limit_req zone=api_semantic burst=10 nodelay;
    limit_conn api_conn 20;
    limit_except GET { deny all; }

    set $upstream_target ${API_PROXY_TARGET};
    rewrite ^/api/(.*)$ /$1 break;
    proxy_http_version 1.1;
    resolver [fd12::10] valid=10s ipv6=on;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
    access_log /dev/stdout main_ext;
    proxy_pass $upstream_target;
  }

  location ^~ /api/card/ {
    if ($is_bot) { return 403; }

    limit_req zone=api_global burst=30 nodelay;
    limit_req zone=api_read burst=20 nodelay;
    limit_conn api_conn 20;
    limit_except GET { deny all; }

    set $upstream_target ${API_PROXY_TARGET};
    rewrite ^/api/(.*)$ /$1 break;
    proxy_http_version 1.1;
    resolver [fd12::10] valid=10s ipv6=on;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
    access_log /dev/stdout main_ext;
    proxy_pass $upstream_target;
  }

  location = /api/oracle-samples {
    if ($is_bot) { return 403; }

    limit_req zone=api_global burst=30 nodelay;
    limit_req zone=api_read burst=20 nodelay;
    limit_conn api_conn 20;
    limit_except GET { deny all; }

    set $upstream_target ${API_PROXY_TARGET};
    rewrite ^/api/(.*)$ /$1 break;
    proxy_http_version 1.1;
    resolver [fd12::10] valid=10s ipv6=on;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
    access_log /dev/stdout main_ext;
    proxy_pass $upstream_target;
  }

  location ^~ /api/telemetry/ {
    if ($is_bot) { return 403; }

    limit_req zone=api_global burst=15 nodelay;
    limit_req zone=api_telemetry burst=10 nodelay;
    limit_conn api_conn 10;
    limit_except POST { deny all; }

    set $upstream_target ${API_PROXY_TARGET};
    rewrite ^/api/(.*)$ /$1 break;
    proxy_http_version 1.1;
    resolver [fd12::10] valid=10s ipv6=on;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
    access_log /dev/stdout main_ext;
    proxy_pass $upstream_target;
  }

  location ^~ /api/admin/ {
    if ($is_bot) { return 403; }

    set $upstream_target ${API_PROXY_TARGET};
    rewrite ^/api/(.*)$ /$1 break;
    proxy_http_version 1.1;
    resolver [fd12::10] valid=10s ipv6=on;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
    access_log /dev/stdout main_ext;
    proxy_pass $upstream_target;
  }

  location ^~ /api/ {
    if ($is_bot) { return 403; }

    limit_req zone=api_global burst=30 nodelay;
    limit_conn api_conn 20;
    limit_except GET { deny all; }

    set $upstream_target ${API_PROXY_TARGET};
    rewrite ^/api/(.*)$ /$1 break;
    proxy_http_version 1.1;
    resolver [fd12::10] valid=10s ipv6=on;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
    access_log /dev/stdout main_ext;
    proxy_pass $upstream_target;
  }

  location ~* \.(?:js|css|png|jpg|jpeg|gif|svg|ico|webp|woff2?)$ {
    expires 30d;
    add_header Cache-Control "public, max-age=2592000, immutable";
    try_files $uri =404;
  }
}
