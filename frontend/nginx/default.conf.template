map $host $is_admin_host {
  default 0;
  "${ADMIN_HOST}" 1;
}

server {
  listen ${PORT};

  server_tokens off;
  absolute_redirect off;

  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size 32k;
  limit_req_status 429;

  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests" always;

  location ^~ /.well-known/ {
    try_files $uri =404;
  }

  # Sitemap is generated by the API; bots are explicitly allowed here so the
  # global $is_bot 403 on /api/* doesn't apply. The bot_allowed_path map
  # already whitelists this URI; we just bypass the api-bot rule.
  location = /sitemap.xml {
    set $upstream_target ${API_PROXY_TARGET};
    rewrite ^/(.*)$ /$1 break;
    resolver ${NGINX_RESOLVER} valid=10s ipv6=on;
    include /etc/nginx/proxy_params;
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
    access_log /dev/stdout main_ext;
    proxy_pass $upstream_target;
  }

  # Internal SEO renderer: returns prerendered HTML for bots so social-preview
  # crawlers and search engines see proper <head> tags + readable body without
  # running JS. Reachable only via internal rewrite from the / location below.
  location = /seo/page {
    internal;
    set $upstream_target ${API_PROXY_TARGET};
    rewrite ^/(.*)$ /$1 break;
    resolver ${NGINX_RESOLVER} valid=10s ipv6=on;
    include /etc/nginx/proxy_params;
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
    access_log /dev/stdout main_ext;
    proxy_pass $upstream_target;
  }

  location ~ /\.(?!well-known)(?:.*)$ {
    return 444;
  }

  location = /xmlrpc.php { return 444; }
  location = /wp-login.php { return 444; }
  location ^~ /wp-admin { return 444; }
  location ^~ /wp-content { return 444; }
  location ^~ /wp-includes { return 444; }
  location ^~ /wordpress { return 444; }
  location ^~ /wp { return 444; }
  location ^~ /phpmyadmin { return 444; }

  location / {
    if ($is_admin_host = 1) { return 302 /admin/; }
    set $block_bot 0;
    if ($is_bot) { set $block_bot "${block_bot}1"; }
    if ($bot_allowed_path = 0) { set $block_bot "${block_bot}1"; }
    if ($block_bot = 011) { return 403; }

    # Bots hitting an allowed path get the prerendered head/body shell from the
    # API so social previews and search-engine snippets work without JS.
    if ($is_bot) { rewrite ^ /seo/page$is_args$args last; }

    try_files $uri $uri/ /index.html;
  }

  location = /admin {
    if ($is_admin_host = 0) { return 404; }
    return 301 /admin/;
  }

  location ^~ /admin/ {
    if ($is_admin_host = 0) { return 404; }
    set $block_bot 0;
    if ($is_bot) { set $block_bot "${block_bot}1"; }
    if ($bot_allowed_path = 0) { set $block_bot "${block_bot}1"; }
    if ($block_bot = 011) { return 403; }
    try_files $uri $uri/ /admin/index.html;
  }

  location = /api/health {
    if ($is_bot) { return 403; }

    set $upstream_target ${API_PROXY_TARGET};
    rewrite ^/api/(.*)$ /$1 break;
    resolver ${NGINX_RESOLVER} valid=10s ipv6=on;
    include /etc/nginx/proxy_params;
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
    access_log /dev/stdout main_ext;
    proxy_pass $upstream_target;
  }

  # Readiness probe: SPA polls this on load to mask cold-start latency with
  # a themed boot overlay. No rate limit (must succeed once warm); no bot block.
  location = /api/ready {
    set $upstream_target ${API_PROXY_TARGET};
    rewrite ^/api/(.*)$ /$1 break;
    resolver ${NGINX_RESOLVER} valid=10s ipv6=on;
    include /etc/nginx/proxy_params;
    proxy_connect_timeout 5s;
    proxy_send_timeout 10s;
    proxy_read_timeout 10s;
    add_header Cache-Control "no-store" always;
    access_log off;
    proxy_pass $upstream_target;
  }

  location = /api/admin/auth/token {
    if ($is_admin_host = 0) { return 404; }
    if ($is_bot) { return 403; }

    limit_req zone=api_admin_login burst=5 nodelay;
    limit_conn api_conn 10;
    limit_except POST { deny all; }

    set $upstream_target ${API_PROXY_TARGET};
    rewrite ^/api/(.*)$ /$1 break;
    resolver ${NGINX_RESOLVER} valid=10s ipv6=on;
    include /etc/nginx/proxy_params;
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
    access_log /dev/stdout main_ext;
    proxy_pass $upstream_target;
  }

  location = /api/version {
    if ($is_bot) { return 403; }

    set $upstream_target ${API_PROXY_TARGET};
    rewrite ^/api/(.*)$ /$1 break;
    resolver ${NGINX_RESOLVER} valid=10s ipv6=on;
    include /etc/nginx/proxy_params;
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
    access_log /dev/stdout main_ext;
    proxy_pass $upstream_target;
  }

  location = /api/search {
    if ($is_bot) { return 403; }

    limit_req zone=api_global burst=30 nodelay;
    limit_req zone=api_search burst=20 nodelay;
    limit_conn api_conn 20;
    limit_except GET { deny all; }

    set $upstream_target ${API_PROXY_TARGET};
    rewrite ^/api/(.*)$ /$1 break;
    resolver ${NGINX_RESOLVER} valid=10s ipv6=on;
    include /etc/nginx/proxy_params;
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
    access_log /dev/stdout main_ext;
    proxy_pass $upstream_target;
  }

  location = /api/similar-cards {
    if ($is_bot) { return 403; }

    limit_req zone=api_global burst=30 nodelay;
    limit_req zone=api_semantic burst=10 nodelay;
    limit_conn api_conn 20;
    limit_except GET { deny all; }

    set $upstream_target ${API_PROXY_TARGET};
    rewrite ^/api/(.*)$ /$1 break;
    resolver ${NGINX_RESOLVER} valid=10s ipv6=on;
    include /etc/nginx/proxy_params;
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
    access_log /dev/stdout main_ext;
    proxy_pass $upstream_target;
  }

  location ^~ /api/card/ {
    if ($is_bot) { return 403; }

    limit_req zone=api_global burst=30 nodelay;
    limit_req zone=api_read burst=20 nodelay;
    limit_conn api_conn 20;
    limit_except GET { deny all; }

    set $upstream_target ${API_PROXY_TARGET};
    rewrite ^/api/(.*)$ /$1 break;
    resolver ${NGINX_RESOLVER} valid=10s ipv6=on;
    include /etc/nginx/proxy_params;
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
    access_log /dev/stdout main_ext;
    proxy_pass $upstream_target;
  }

  location = /api/oracle-samples {
    if ($is_bot) { return 403; }

    limit_req zone=api_global burst=30 nodelay;
    limit_req zone=api_read burst=20 nodelay;
    limit_conn api_conn 20;
    limit_except GET { deny all; }

    set $upstream_target ${API_PROXY_TARGET};
    rewrite ^/api/(.*)$ /$1 break;
    resolver ${NGINX_RESOLVER} valid=10s ipv6=on;
    include /etc/nginx/proxy_params;
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
    access_log /dev/stdout main_ext;
    proxy_pass $upstream_target;
  }

  location ^~ /api/telemetry/ {
    if ($is_bot) { return 403; }

    limit_req zone=api_global burst=15 nodelay;
    limit_req zone=api_telemetry burst=10 nodelay;
    limit_conn api_conn 10;
    limit_except POST { deny all; }

    set $upstream_target ${API_PROXY_TARGET};
    rewrite ^/api/(.*)$ /$1 break;
    resolver ${NGINX_RESOLVER} valid=10s ipv6=on;
    include /etc/nginx/proxy_params;
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
    access_log /dev/stdout main_ext;
    proxy_pass $upstream_target;
  }

  location ^~ /api/admin/ {
    if ($is_admin_host = 0) { return 404; }
    if ($is_bot) { return 403; }

    set $upstream_target ${API_PROXY_TARGET};
    rewrite ^/api/(.*)$ /$1 break;
    resolver ${NGINX_RESOLVER} valid=10s ipv6=on;
    include /etc/nginx/proxy_params;
    proxy_connect_timeout 5s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
    access_log /dev/stdout main_ext;
    proxy_pass $upstream_target;
  }

  location ^~ /api/ {
    if ($is_bot) { return 403; }

    limit_req zone=api_global burst=30 nodelay;
    limit_conn api_conn 20;
    limit_except GET { deny all; }

    set $upstream_target ${API_PROXY_TARGET};
    rewrite ^/api/(.*)$ /$1 break;
    resolver ${NGINX_RESOLVER} valid=10s ipv6=on;
    include /etc/nginx/proxy_params;
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
    access_log /dev/stdout main_ext;
    proxy_pass $upstream_target;
  }

  location ~* \.(?:js|css|png|jpg|jpeg|gif|svg|ico|webp|woff2?)$ {
    expires 30d;
    add_header Cache-Control "public, max-age=2592000, immutable";
    try_files $uri =404;
  }
}
